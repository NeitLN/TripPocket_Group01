# Copy this file to keystore.properties (same folder, git-ignored) and fill in your own values.
# keystore.properties is never committed: it holds the passwords.
# The keystore itself must also stay outside the repo.
storeFile=D:/TripPocket-keys/release-key.jks
storePassword=PASTE_STORE_PASSWORD_HERE
keyAlias=trippocket
keyPassword=PASTE_KEY_PASSWORD_HERE
