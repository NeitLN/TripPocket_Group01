<?xml version="1.0" encoding="utf-8"?>
<!--
    One nearby sight (Milestone 4): photo, name, description, distance and "Add to day".
    - The 56dp photo is a remote URL loaded by Glide in SightAdapter (Corner12, like the
      search rows); it is decorative, the name next to it is the label.
    - The description is optional: when it is GONE the distance row moves up.
    - The whole row is a flat ConstraintLayout inside the card; the text column ends at the
      card edge so a long name wraps instead of running under the button.
    - "Add to day" is 48dp tall for an easy touch target.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_sm"
    android:layout_marginVertical="@dimen/space_xs">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_md">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSightImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/colorSurfaceContainerHighest"
            android:contentDescription="@null"
            android:scaleType="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.TripPocket.Corner12"
            tools:src="@drawable/ic_image" />

        <TextView
            android:id="@+id/tvSightTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivSightImage"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Hồ Xuân Hương" />

        <TextView
            android:id="@+id/tvSightDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvSightTitle"
            app:layout_constraintTop_toBottomOf="@id/tvSightTitle"
            tools:text="Lake in Da Lat, Vietnam" />

        <TextView
            android:id="@+id/tvSightDistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorTertiary"
            app:layout_constraintBaseline_toBaselineOf="@id/btnAddToDay"
            app:layout_constraintEnd_toStartOf="@id/btnAddToDay"
            app:layout_constraintStart_toStartOf="@id/tvSightTitle"
            app:layout_constraintTop_toBottomOf="@id/tvSightDescription"
            tools:text="350 m" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToDay"
            style="@style/Widget.TripPocket.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/sights_add_to_day"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSightDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
