<?xml version="1.0" encoding="utf-8"?>
<!-- Edit-place-note dialog body (WP): multi-line note, up to 300 characters.
     Used with MaterialAlertDialogBuilder.setView; the dialog supplies title and buttons. -->
<com.google.android.material.textfield.TextInputLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tilNote"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_xl"
    android:paddingTop="@dimen/space_sm"
    android:hint="@string/weather_place_note_hint"
    app:counterEnabled="true"
    app:counterMaxLength="300">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:imeOptions="actionNone"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="300"
        android:maxLines="8"
        android:minLines="3" />
</com.google.android.material.textfield.TextInputLayout>

