<?xml version="1.0" encoding="utf-8"?>
<!--
    Screen 2 - Trip List, sticker identity (DESIGN.md).
    - "My trips" in Be Vietnam Pro Black with "trips" on the lime sticker highlight (set in code),
      then the trip count, then the grouped list.
    - The RecyclerView stops at @dimen/content_max_width so tablets stay readable; the column
      count comes from @integer/trip_grid_span and group labels span every column.
    - The lime "New trip" FAB is the one loud action; the list keeps @dimen/fab_clearance at
      the bottom so the last card scrolls above it.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.trips.TripListFragment">

    <LinearLayout
        android:id="@+id/tripPostcard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/bg_mail_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/title_inset"
        android:paddingVertical="@dimen/postcard_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/trips_title"
                android:textAppearance="@style/TextAppearance.TripPocket.ScreenTitle"
                android:textColor="@color/postcard_paper"
                tools:targetApi="28" />

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/postcard_paper"
                tools:text="3 trips" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/postcard_stamp_width"
            android:layout_height="@dimen/postcard_stamp_height"
            android:layout_marginStart="@dimen/space_sm"
            android:importantForAccessibility="no"
            android:rotation="6"
            android:src="@drawable/ic_ha_long_stamp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrips"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_xs"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_sm"
        android:paddingBottom="@dimen/fab_clearance"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tripPostcard"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        tools:itemCount="3"
        tools:listitem="@layout/item_trip" />

    <ScrollView
        android:id="@+id/groupEmpty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tripPostcard"
        app:layout_constraintWidth_max="@dimen/form_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/fab_clearance">

            <ImageView
                android:padding="@dimen/space_xs"
                android:id="@+id/ivEmpty"
                android:layout_width="@dimen/empty_icon_size"
                android:layout_height="@dimen/empty_icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/art_route" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="@string/trips_empty_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/tvEmptyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/trips_empty_body"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNewTrip"
        style="@style/Widget.TripPocket.ExtendedFab.Lime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_margin"
        android:text="@string/trips_new"
        app:icon="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
