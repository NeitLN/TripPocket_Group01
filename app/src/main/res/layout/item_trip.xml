<?xml version="1.0" encoding="utf-8"?>
<!--
    Trip card (row of Screen 2), sticker identity (DESIGN.md).
    - Left: an 80dp slot holding the 64dp trip sticker, so its tilt and shadow never touch text.
    - Right: a column that wraps and grows: name, destination, dates + duration, members + spent,
      then the backup status row. Nothing here has a fixed height, so large font sizes work.
    - Backup status is an icon + plain label (+ "Saved on this phone" when not backed up); Retry
      is its own 48dp text button, shown only when the backup failed.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTrip"
    style="@style/Widget.TripPocket.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_sm"
    android:layout_marginVertical="@dimen/space_xs"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <FrameLayout
            android:id="@+id/stickerSlot"
            android:layout_width="@dimen/sticker_slot"
            android:layout_height="@dimen/sticker_slot"
            android:clipChildren="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <vn.edu.vlu.trippocket.ui.common.TripStickerView
                android:id="@+id/sticker"
                android:layout_width="@dimen/sticker_size"
                android:layout_height="@dimen/sticker_size"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTripName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.TripPocket.CardTitle"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/stickerSlot"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Phú Quốc Summer" />

        <TextView
            android:id="@+id/tvDestination"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="@id/tvTripName"
            app:layout_constraintStart_toStartOf="@id/tvTripName"
            app:layout_constraintTop_toBottomOf="@id/tvTripName"
            tools:text="Phú Quốc, Kiên Giang" />

        <TextView
            android:id="@+id/tvDates"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="@id/tvTripName"
            app:layout_constraintStart_toStartOf="@id/tvTripName"
            app:layout_constraintTop_toBottomOf="@id/tvDestination"
            tools:text="20 Jun - 24 Jun 2027 · 5 days" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textAppearance="@style/TextAppearance.TripPocket.Money"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@id/tvTripName"
            app:layout_constraintStart_toStartOf="@id/tvTripName"
            app:layout_constraintTop_toBottomOf="@id/tvDates"
            tools:text="2 members · 0 ₫ spent" />

        <!-- Backup status: icon + label, with the note under the label. -->
        <ImageView
            android:id="@+id/ivSync"
            android:layout_width="@dimen/icon_size_sm"
            android:layout_height="@dimen/icon_size_sm"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="@id/tvSync"
            app:layout_constraintStart_toStartOf="@id/tvTripName"
            app:layout_constraintTop_toTopOf="@id/tvSync"
            tools:src="@drawable/ic_cloud_alert"
            tools:tint="?attr/colorError" />

        <TextView
            android:id="@+id/tvSync"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@id/btnRetry"
            app:layout_constraintStart_toEndOf="@id/ivSync"
            app:layout_constraintTop_toBottomOf="@id/tvMeta"
            tools:text="@string/sync_failed" />

        <TextView
            android:id="@+id/tvSyncNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sync_saved_on_phone"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="@id/tvSync"
            app:layout_constraintStart_toStartOf="@id/tvSync"
            app:layout_constraintTop_toBottomOf="@id/tvSync" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.TripPocket.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/sync_retry"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tvSyncNote"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvSync"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
