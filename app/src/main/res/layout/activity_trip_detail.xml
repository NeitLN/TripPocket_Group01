<?xml version="1.0" encoding="utf-8"?>
<!--
    Trip Detail host: top app bar + fragment area + bottom navigation.
    The fragment area is constrained between the toolbar and the bottom bar
    (0dp height), so each module fragment (Itinerary / Checklist / Weather / Expenses)
    always gets exactly the space left over on any screen height.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.detail.TripDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/content_desc_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        tools:subtitle="24 Oct - 27 Oct 2026"
        tools:title="Đà Lạt Getaway" />

    <!-- NavHostFragment without app:navGraph: TripDetailActivity sets nav_trip_detail
         once the trip is known to belong to the signed-in account. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/detailContainer"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:layout="@layout/fragment_itinerary" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_trip_detail" />

</androidx.constraintlayout.widget.ConstraintLayout>
