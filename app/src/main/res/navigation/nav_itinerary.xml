<?xml version="1.0" encoding="utf-8"?>
<!-- Owner: Bảo. Add this module's screens here. The trip id is not a nav argument:
     use tripViewModels { ... } (ui/detail/TripArgs.kt). -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_itinerary"
    app:startDestination="@id/itineraryFragment">

    <fragment
        android:id="@+id/itineraryFragment"
        android:name="vn.edu.vlu.trippocket.ui.itinerary.ItineraryFragment"
        android:label="@string/nav_itinerary">
        <action
            android:id="@+id/action_itinerary_to_form"
            app:destination="@id/activityFormFragment" />
    </fragment>

    <!-- I1: add (no activityId) or edit (activityId of the row). -->
    <fragment
        android:id="@+id/activityFormFragment"
        android:name="vn.edu.vlu.trippocket.ui.itinerary.ActivityFormFragment"
        android:label="@string/itinerary_form_add_title">
        <argument
            android:name="activityId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

</navigation>
